ehthumbs.db
Thumbs.db

# don't upload private plugins or symlinked dirs
/priv_*

# don't upload plugins loaded from develop to a release installation
/*_dev/

# Pycharm settings
/.idea
/.vs

# VSCode settings
.vscode/settings.json

# pyright stub packages (tools/pyright_stub_audit.py) — local dev aid,
# CI lints with ruff, not pyright; regenerate with --apply-create if needed
/typings/

# Node dependencies for the matter plugin's server and bridge roles
# (dev/matter/matter-integration-plan.md in the core repo) - package.json
# and package-lock.json are tracked for reproducible installs, the
# installed packages themselves are not.
matter/sidecar/node_modules/

# local mise config - pins tool versions AND an absolute venv path specific
# to this machine (see ../shng/.gitignore for the same convention)
/*.toml
!/pyproject.toml
